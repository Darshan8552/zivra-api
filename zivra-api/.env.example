# Copy to .env and fill with real values — NEVER commit .env
# Required for `ConfigModule` Joi validation (zivra-api/src/config/env.validation.ts)

# App
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database — Neon pooled URL
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.c-3.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# JWT — min 32 chars each (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
JWT_ACCESS_SECRET=replace_with_32_plus_char_random_string
JWT_REFRESH_SECRET=replace_with_32_plus_char_random_string
JWT_RESET_SECRET=replace_with_32_plus_char_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis — Upstash rediss://
UPSTASH_REDIS_URL=rediss://default:TOKEN@hostname:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# API versioning — URI versioning, defaultVersion fallback keeps /api and /api/v1 both working
API_VERSION=1

# Brevo (email)
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=you@example.com
BREVO_SENDER_NAME=Zivra
